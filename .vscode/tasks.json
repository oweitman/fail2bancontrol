{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "frontend: build",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/src-frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "docker: build image",
            "type": "shell",
            "command": "docker build -t fail2bancontrol .",
            "dependsOn": [
                "frontend: build"
            ],
            "problemMatcher": []
        },
        {
            "label": "frontend: dev",
            "type": "shell",
            "command": "npm run dev -- --host 0.0.0.0 --port 5173 --strictPort",
            "options": {
                "cwd": "${workspaceFolder}/src-frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE v",
                    "endsPattern": "Local:.*5173"
                }
            }
        },
        {
            "label": "backend: dev",
            "type": "shell",
            "command": "sudo -E /usr/local/bin/python -u src-backend/app.py",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "STATIC_ROOT": "${workspaceFolder}/src-frontend/dist",
                    "PORT": "9000"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "python",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^$",
                    "endsPattern": "Server running on port 9000"
                }
            }
        },
        {
            "label": "dev: start",
            "dependsOn": [
                "backend: dev",
                "frontend: dev"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "backend: test",
            "type": "shell",
            "command": "python -m unittest discover -s test -v",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "frontend: lint",
            "type": "shell",
            "command": "npm run lint",
            "options": {
                "cwd": "${workspaceFolder}/src-frontend"
            },
            "problemMatcher": []
        }
    ]
}
