{
    "name": "Fail2Ban Control (Python 3.12 + Node 24)",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24"
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/fail2bancontrol,type=bind",
    "workspaceFolder": "/workspaces/fail2bancontrol",
    "mounts": [
        "source=/home/iobroker/docker/volume/nextcloud/fail2ban/socket,target=/var/run/fail2ban,type=bind",
        "source=/home/iobroker/docker/volume/nextcloud/nginx/log,target=/var/log/nginx,type=bind,readonly",
        "source=/home/iobroker/docker/volume/nextcloud/fail2ban/log,target=/var/log/fail2ban,type=bind,readonly",
        "source=${localWorkspaceFolderBasename}-dev-node-modules,target=/workspaces/fail2bancontrol/src-frontend/node_modules,type=volume"
    ],
    "containerEnv": {
        "F2B_SOCKET": "/var/run/fail2ban/fail2ban.sock",
        "STATIC_ROOT": "/workspaces/fail2bancontrol/src-frontend/dist",
        "PORT": "9000",
        "TZ": "Europe/Berlin",
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "postCreateCommand": "sudo chown -R \"$(id -u):$(id -g)\" src-frontend/node_modules && npm --prefix src-frontend ci",
    "forwardPorts": [
        5173,
        9000
    ],
    "portsAttributes": {
        "5173": {
            "label": "Frontend (Vite)",
            "onAutoForward": "notify"
        },
        "9000": {
            "label": "Backend API",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "eslint.workingDirectories": [
                    "./src-frontend"
                ]
            },
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "remoteUser": "vscode",
    "updateRemoteUserUID": true
}
